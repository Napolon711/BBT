<?xml version="1.0"?>
<!-- All business priority and crossing sequencing is expressed here. Leaves own only
     individual I/O operations; blackboard evidence survives reactive tree halts. -->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <ReactiveSequence>
      <ReadInputs/>
      <ReactiveFallback>
        <ReactiveSequence>
          <MatchRunning/>
          <BeginMatch/>
          <UpdateHomeLatch/>
          <ObserveOperator/>
          <ForceSuccess>
            <Sequence>
              <AutoBuyEnabled/>
              <ForceSuccess><Sequence><AmmoPurchaseDue/><BuyAmmo/></Sequence></ForceSuccess>
              <ForceSuccess><Sequence><HpPurchaseDue/><BuyHp/></Sequence></ForceSuccess>
              <ForceSuccess>
                <Sequence>
                  <RevivePurchaseDue/>
                  <Fallback><FreeReviveAllowed/><PaidReviveAllowed/></Fallback>
                  <BuyRevive/>
                </Sequence>
              </ForceSuccess>
            </Sequence>
          </ForceSuccess>
          <Fallback>
            <Sequence>
              <HasOperatorTarget/>
              <Fallback>
                <ForceFailure>
                  <Sequence>
                    <OperatorHoldElapsed/>
                    <Fallback><HomeLatched/><OperatorClearElapsed/></Fallback>
                    <ConsumeOperator/>
                  </Sequence>
                </ForceFailure>
                <Sequence><HasOperatorTarget/><SelectOperator/></Sequence>
              </Fallback>
            </Sequence>
            <Sequence><HomeLatched/><SelectHome/></Sequence>
            <Sequence><OwnOutpostNeeds/><SelectRetake/></Sequence>
            <Sequence><EnemyOutpostNeeds/><SelectOutpost/></Sequence>
            <SelectPatrol/>
          </Fallback>
          <CommitTarget/>
          <ReactiveFallback>
            <ReactiveSequence>
              <NeedsTunnel/>
              <ReactiveFallback>
                <ReactiveSequence>
                  <PrepareTunnel/>
                  <TunnelQuiet/>
                  <ReactiveFallback>
                    <ReactiveSequence><TunnelCooldown/><WaitStopped/></ReactiveSequence>
                    <ReactiveSequence>
                      <TunnelExitReached/>
                      <ExplicitStop/>
                      <ReactiveFallback><Unfolded/><RequestUnfold/></ReactiveFallback>
                      <CompleteTunnel/>
                    </ReactiveSequence>
                    <ReactiveSequence>
                      <CrossingNavigationActive/>
                      <Inverter><Folded/></Inverter>
                      <FailTunnel/>
                    </ReactiveSequence>
                    <ReactiveSequence>
                      <ReactiveFallback><CrossingCommitted/><NavigateEntry/></ReactiveFallback>
                      <ReactiveFallback>
                        <Folded/>
                        <ReactiveSequence><ExplicitStop/><RequestFold/></ReactiveSequence>
                      </ReactiveFallback>
                      <TraverseTunnel/>
                    </ReactiveSequence>
                  </ReactiveFallback>
                </ReactiveSequence>
                <WaitStopped/>
              </ReactiveFallback>
            </ReactiveSequence>
            <ReactiveSequence>
              <HasTarget/>
              <ReactiveFallback>
                <ReactiveSequence>
                  <OwnsOrdinaryRequest/>
                  <ReactiveFallback>
                    <ReactiveSequence><OrdinaryFailed/><FailOrdinary/></ReactiveSequence>
                    <TacticalKeep/>
                  </ReactiveFallback>
                </ReactiveSequence>
                <ReactiveSequence><OrdinaryRetryBlocked/><WaitStopped/></ReactiveSequence>
                <SubmitOrdinary/>
              </ReactiveFallback>
            </ReactiveSequence>
            <WaitStopped/>
          </ReactiveFallback>
        </ReactiveSequence>
        <Standby/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
