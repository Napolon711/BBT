<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_libxr</name>
  <version>2.0.0</version>
  <description>
    STM32 下位机 ↔ ROS 2 转接桥（2027 赛季版）。
    只做两件事：把下位机转发的裁判系统原始帧按 2027 协议解析成 ROS 话题；
    把上位机要发的帧组好交给下位机。所有位域解释都在上位机，协议改动不需要重新烧录下位机。
  </description>
  <maintainer email="sentry@27bt.local">27BT-UC sentry</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rm2027_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
